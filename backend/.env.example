# =============================================================================
# backend/.env.example — template untuk backend Express
# Salin ke .env dan isi nilainya. Jangan commit .env ke git.
# =============================================================================

# Koneksi PostgreSQL (harus match dengan root .env)
DATABASE_URL=postgres://sugity:your_password_here@localhost:5432/sugity-production-planning

# Koneksi Redis
REDIS_URL=redis://localhost:6379

# JWT (generate: openssl rand -hex 32)
JWT_SECRET=

# PIN Encryption — wajib ada, server akan crash jika kosong
# (generate: openssl rand -hex 32)
PIN_ENCRYPTION_KEY=

# Port backend
PORT=3000
